# Jamzo — local environment. Copy to .env and adjust. NEVER commit real secrets (.env is git-ignored).
APP_ENV=development
LOG_LEVEL=info

# Database: `pnpm dev:db` (embedded PostgreSQL, no Docker) or `docker compose up postgres`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/jamzo
# With docker compose instead: postgresql://jamzo:jamzo@127.0.0.1:5432/jamzo

# API
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=false
# Only needed if a browser calls the API directly (the admin uses its own same-origin proxy).
CORS_ORIGINS=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
OTP_PEPPER=replace-with-another-long-random-secret-32-chars
# Encrypts bank account numbers (32 random bytes, base64). Losing it makes stored account numbers unreadable;
# keep it in a secret manager in staging/production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Google Maps Routes API key (D-81). Leave empty until the owner creates it; only used when Jamzo Admin sets
# Delivery → Maps provider to GOOGLE. Never put it in an app or the admin site.
GOOGLE_MAPS_API_KEY=
# Online payments (D-82): fake (development/tests only) or razorpay. Razorpay test keys (rzp_test_…) outside
# production; live keys only in production. Webhook secret = the one set on the Razorpay webhook.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Development-only providers: OTPs are printed in the API log. Refused in staging/production.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Secure cookies need HTTPS; false only for local http://localhost.
COOKIE_SECURE=false
ADMIN_COOKIE_PATH=/api/v1
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=../../var/media
MEDIA_MAX_BYTES=10485760
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_PER_MIN=10

# Workers
WORKER_POLL_MS=1000
# Push for order notifications (D-69). console = development only (refused in staging/production).
# expo = Expo push service — not verified until the EAS projects exist (Q-18); EXPO_ACCESS_TOKEN optional.
PUSH_PROVIDER=console

# Seed (first Super Admin; the seed never changes an existing account's password)
SEED_ADMIN_EMAIL=admin@jamzo.local
SEED_ADMIN_PASSWORD=Change-Me-Admin-1
SEED_DEMO=true
