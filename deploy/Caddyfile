# HTTPS for the public names (D-101, D-115). DNS at Cloudflare (grey cloud): A records api, admin, jamzo.in and www
# → the Droplet's IP.
api.jamzo.in {
	encode zstd gzip
	reverse_proxy api:4000
}

admin.jamzo.in {
	encode zstd gzip
	reverse_proxy admin:3000
}

# The website (D-115): static pages generated by scripts/build-website.mjs into apps/website/public.
jamzo.in {
	encode zstd gzip
	root * /srv/www
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Cache-Control "public, max-age=3600"
	}
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.jamzo.in {
	redir https://jamzo.in{uri} permanent
}
