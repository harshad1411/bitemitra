{
  "name": "@jamzo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jamzo HTTP API \u2014 modular monolith (Fastify, Prisma 6, PostgreSQL).",
  "type": "module",
  "main": "src/server.js",
  "exports": {
    "./app": "./src/app.js",
    "./media-storage": "./src/modules/media/storage.js"
