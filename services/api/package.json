    "@fastify/rate-limit": "^11.2.0",
    "@jamzo/auth": "workspace:*",
    "@jamzo/catalog-engine": "workspace:*",
    "@jamzo/config": "workspace:*",
    "@jamzo/database": "workspace:*",
    "@jamzo/delivery-engine": "workspace:*",
    "@jamzo/logger": "workspace:*",
    "@jamzo/notifications": "workspace:*",
    "@jamzo/shared-types": "workspace:*",
    "@jamzo/validation": "workspace:*",
    "fastify": "^5.12.5",
