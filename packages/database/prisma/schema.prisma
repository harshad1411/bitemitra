/// Bank details. Account number stored encrypted at the application layer (AES-GCM,
/// key from env) plus last-4 for display. Changes are audit-logged (spec §43).
model RestaurantBankAccount {
  id                     String    @id @default(uuid(7)) @db.Uuid
  restaurantId           String    @db.Uuid
  accountHolderName      String
  accountNumberEncrypted String
  accountNumberLast4     String
  ifsc                   String
  bankName               String?
  upiId                  String?
  isPrimary              Boolean   @default(false) // becomes true only on verification (D-35)
  createdById            String?   @db.Uuid // admin who entered the details
  verifiedById           String?   @db.Uuid // a different admin (four-eyes)
  verifiedAt             DateTime? @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("restaurant_bank_accounts")
}

