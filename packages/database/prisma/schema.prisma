/// Generic hierarchical key/value settings (operational config, not money rules).
/// e.g. orders.restaurantAcceptanceTimeoutSec, cod.maxOrderValuePaise, app.minVersion.
model Setting {
  id          String      @id @default(uuid(7)) @db.Uuid
  key         String
  scope       ConfigScope
  scopeRefId  String?     @db.Uuid
  value       Json
  updatedById String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  history SettingHistory[]

  @@unique([key, scope, scopeRefId])
  @@index([key])
  @@map("settings")
}

/// Configuration history (spec §63). Survives removal of the override (settingId → NULL), so a
/// "reset to inherited value" never erases who changed what.
model SettingHistory {
  id          String      @id @default(uuid(7)) @db.Uuid
  settingId   String?     @db.Uuid
  key         String
  scope       ConfigScope
  scopeRefId  String?     @db.Uuid
  oldValue    Json?
  newValue    Json?
  reason      String? // required for settings marked critical (CONFIGURATION.md)
  changedById String?     @db.Uuid
  changedAt   DateTime    @default(now()) @db.Timestamptz(3)

  setting Setting? @relation(fields: [settingId], references: [id], onDelete: SetNull)

  @@index([settingId, changedAt])
  @@index([key, changedAt])
  @@map("setting_history")
}

