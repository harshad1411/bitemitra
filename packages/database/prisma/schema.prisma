  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  customer                Customer?
  rider                   Rider?
  adminUser               AdminUser?
  restaurantUsers         RestaurantUser[]
  identities              AuthIdentity[]
  sessions                Session[]
  devices                 Device[]
