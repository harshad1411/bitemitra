// ───────────────────────────── Identity & access ─────────────────────────────

/// One human identity. Profiles (Customer, Rider, RestaurantUser, AdminUser) hang off it.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  phone         String?    @unique // E.164, e.g. +919876543210
  phoneVerified Boolean    @default(false)
  email         String?    @unique // lower-cased
  emailVerified Boolean    @default(false)
  passwordHash  String? // argon2id; only admin / restaurant web logins use passwords
  name          String?
  status        UserStatus @default(ACTIVE)
  deletedAt     DateTime? // account deletion (spec §49): PII scrubbed, row kept for FK integrity
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  customer                Customer?
  rider                   Rider?
  adminUser               AdminUser?
  restaurantUsers         RestaurantUser[]
  sessions                Session[]
  devices                 Device[]
  consents                ConsentRecord[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  phone       String
  purpose     OtpPurpose @default(LOGIN)
  appId       AppId
  codeHash    String // HMAC-SHA256(code, OTP_PEPPER); the code itself is never stored
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// Refresh-token session. Tokens rotate on every refresh; reuse of a rotated token revokes the family.
model Session {
  id               String          @id @default(uuid(7)) @db.Uuid
  userId           String          @db.Uuid
  appId            AppId
  familyId         String          @db.Uuid
  refreshTokenHash String          @unique // SHA-256 of the opaque refresh token
  platform         DevicePlatform?
  appVersion       String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime        @default(now())
  lastUsedAt       DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appId])
  @@index([familyId])
  @@map("sessions")
}

model Device {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @db.Uuid
  appId        AppId
  platform     DevicePlatform
  pushToken    String // Expo push token (wraps FCM/APNs) or raw FCM/APNs token
  pushProvider String         @default("expo")
  appVersion   String?
  osVersion    String?
  lastSeenAt   DateTime       @default(now())
  disabledAt   DateTime?
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, pushToken])
  @@index([userId])
  @@map("devices")
}

model AdminUser {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @unique @db.Uuid
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  roles AdminUserRole[]

  @@map("admin_users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique // e.g. SUPER_ADMIN, OPERATIONS
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  admins      AdminUserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique // e.g. orders.view — mirrors @bitemitra/auth PERMISSIONS
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUserRole {
  adminUserId String  @db.Uuid
  roleId      String  @db.Uuid
  /// Optional scoping (e.g. an Operations admin limited to one city). Null = all.
  cityId      String? @db.Uuid

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model ConsentRecord {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  kind      String // e.g. TERMS, PRIVACY, MARKETING_SMS
  version   String
  granted   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consent_records")
}

model NotificationPreference {
  userId  String              @db.Uuid
  channel NotificationChannel
  topic   String // e.g. ORDER_UPDATES, PROMOTIONS
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel, topic])
  @@map("notification_preferences")
}

// ───────────────────────────── Geography & service areas ─────────────────────────────

model Country {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique // ISO 3166-1 alpha-2
  name         String
  currencyCode String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(uuid(7)) @db.Uuid
  countryId String   @db.Uuid
  code      String // e.g. GJ
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@unique([countryId, code])
  @@map("states")
}

model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  stateId   String   @db.Uuid
  slug      String   @unique // e.g. unjha
  name      String
  timezone  String   @default("Asia/Kolkata")
  centerLat Decimal  @db.Decimal(9, 6)
  centerLng Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(false) // launched / accepting orders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state       State        @relation(fields: [stateId], references: [id])
  zones       Zone[]
  restaurants Restaurant[]

  @@index([stateId])
  @@map("cities")
}

/// Operational zone inside a city. Geometry is a GeoJSON Polygon/MultiPolygon; bbox
/// columns allow an indexed pre-filter before the exact point-in-polygon test.
model Zone {
  id        String   @id @default(uuid(7)) @db.Uuid
  cityId    String   @db.Uuid
  slug      String
  name      String
  geometry  Json // GeoJSON Polygon | MultiPolygon, [lng, lat] order
  minLat    Decimal  @db.Decimal(9, 6)
  minLng    Decimal  @db.Decimal(9, 6)
  maxLat    Decimal  @db.Decimal(9, 6)
  maxLng    Decimal  @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city         City             @relation(fields: [cityId], references: [id])
  serviceAreas ServiceArea[]
  restaurants  RestaurantZone[]

  @@unique([cityId, slug])
  @@index([minLat, maxLat, minLng, maxLng])
  @@map("zones")
}

/// A deliverable area within a zone: either a polygon or a centre+radius circle.
model ServiceArea {
  id        String   @id @default(uuid(7)) @db.Uuid
  zoneId    String   @db.Uuid
  name      String
  kind      String // POLYGON | RADIUS
  geometry  Json? // when POLYGON
  centerLat Decimal? @db.Decimal(9, 6) // when RADIUS
  centerLng Decimal? @db.Decimal(9, 6)
  radiusM   Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@map("service_areas")
}

// ───────────────────────────── Customers ─────────────────────────────

model Customer {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @unique @db.Uuid
  codDisabled      Boolean  @default(false)
  defaultAddressId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  addresses      CustomerAddress[]
  orders         Order[]
  favorites      FavoriteRestaurant[]
  reviews        Review[]
  couponUsages   CouponUsage[]
  supportTickets SupportTicket[]

  @@map("customers")
}

model CustomerAddress {
  id           String    @id @default(uuid(7)) @db.Uuid
  customerId   String    @db.Uuid
  label        String // Home / Work / custom
  line1        String
  line2        String?
  landmark     String?
  area         String?
  cityName     String
  pincode      String?
  lat          Decimal   @db.Decimal(9, 6)
  lng          Decimal   @db.Decimal(9, 6)
  zoneId       String?   @db.Uuid // resolved at save time; re-resolved at checkout
  contactName  String?
  contactPhone String?
  deletedAt    DateTime? // soft delete: orders keep their own OrderAddress copy
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_addresses")
}

model FavoriteRestaurant {
  customerId   String   @db.Uuid
  restaurantId String   @db.Uuid
  createdAt    DateTime @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([customerId, restaurantId])
  @@map("favorite_restaurants")
}

// ───────────────────────────── Restaurants ─────────────────────────────

/// A restaurant brand/business. Physical outlets are RestaurantBranch; today every
/// restaurant has exactly one branch, but chains / multi-branch are supported (spec §76).
model Restaurant {
  id               String                     @id @default(uuid(7)) @db.Uuid
  cityId           String                     @db.Uuid
  slug             String                     @unique
  name             String
  legalName        String?
  description      String?
  cuisines         String[]
  isPureVeg        Boolean                    @default(false)
  logoMediaId      String?                    @db.Uuid
  coverMediaId     String?                    @db.Uuid
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  fssaiNumber      String?
  fssaiExpiresOn   DateTime?                  @db.Date
  onboardingStatus RestaurantOnboardingStatus @default(DRAFT)
  isPromoted       Boolean                    @default(false)
  ratingAvg        Decimal                    @default(0) @db.Decimal(3, 2)
  ratingCount      Int                        @default(0)
  sortWeight       Int                        @default(0) // admin-controlled ordering
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  city           City                    @relation(fields: [cityId], references: [id])
  branches       RestaurantBranch[]
  users          RestaurantUser[]
  documents      RestaurantDocument[]
  bankAccounts   RestaurantBankAccount[]
  settings       RestaurantSettings?
  zones          RestaurantZone[]
  menuCategories MenuCategory[]
  products       Product[]
  orders         Order[]
  favorites      FavoriteRestaurant[]
  reviews        Review[]
  ledger         RestaurantLedger?
  settlements    RestaurantSettlement[]

  @@index([cityId, onboardingStatus])
  @@map("restaurants")
}

model RestaurantBranch {
  id              String    @id @default(uuid(7)) @db.Uuid
  restaurantId    String    @db.Uuid
  name            String
  addressLine     String
  area            String?
  pincode         String?
  lat             Decimal   @db.Decimal(9, 6)
  lng             Decimal   @db.Decimal(9, 6)
  zoneId          String?   @db.Uuid
  isPrimary       Boolean   @default(true)
  isOpen          Boolean   @default(false) // live open/closed toggle
  pausedUntil     DateTime? // temporary pause
  busyMode        Boolean   @default(false)
  prepTimeMinutes Int       @default(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant    Restaurant                @relation(fields: [restaurantId], references: [id])
  businessHours RestaurantBusinessHours[]

  @@index([restaurantId])
  @@index([lat, lng])
  @@map("restaurant_branches")
}

model RestaurantBusinessHours {
  id        String @id @default(uuid(7)) @db.Uuid
  branchId  String @db.Uuid
  dayOfWeek Int // 0 = Sunday … 6 = Saturday
  opensAt   String // "HH:mm" local time
  closesAt  String // may be < opensAt for past-midnight hours

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
  @@map("restaurant_business_hours")
}

model RestaurantUser {
  id           String             @id @default(uuid(7)) @db.Uuid
  restaurantId String             @db.Uuid
  userId       String             @db.Uuid
  role         RestaurantUserRole @default(MANAGER)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([restaurantId, userId])
  @@index([userId])
  @@map("restaurant_users")
}

model RestaurantDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  restaurantId String         @db.Uuid
  kind         String // FSSAI, GST, PAN, SHOP_ACT, CANCELLED_CHEQUE …
  number       String?
  mediaId      String?        @db.Uuid
  status       DocumentStatus @default(PENDING)
  expiresOn    DateTime?      @db.Date
  reviewedById String?        @db.Uuid
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("restaurant_documents")
}

/// Bank details. Account number stored encrypted at the application layer (AES-GCM,
/// key from env) plus last-4 for display. Changes are audit-logged (spec §43).
model RestaurantBankAccount {
  id                     String    @id @default(uuid(7)) @db.Uuid
  restaurantId           String    @db.Uuid
  accountHolderName      String
  accountNumberEncrypted String
  accountNumberLast4     String
  ifsc                   String
  bankName               String?
  upiId                  String?
  isPrimary              Boolean   @default(true)
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@map("restaurant_bank_accounts")
}

/// Operational (non-commercial) settings. Commercial values live in rule tables.
model RestaurantSettings {
  restaurantId         String             @id @db.Uuid
  acceptanceTimeoutSec Int? // null = inherit from config
  autoAccept           Boolean            @default(false)
  settlementSchedule   SettlementSchedule @default(WEEKLY)
  selfEditMenu         Boolean            @default(false)
  packagingChargePaise Int? // null = inherit
  minOrderPaise        Int?
  deliveryRadiusM      Int?
  codEnabled           Boolean            @default(true)
  updatedAt            DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model RestaurantZone {
  restaurantId String @db.Uuid
  zoneId       String @db.Uuid

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([restaurantId, zoneId])
  @@map("restaurant_zones")
}

// ───────────────────────────── Catalog / menu ─────────────────────────────

/// Platform-wide food taxonomy (Pizza, Biryani, Desserts…) used for discovery + rule scoping.
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  iconMediaId String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]

  @@map("categories")
}

/// A restaurant's own menu section ("Starters", "Combos").
model MenuCategory {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @db.Uuid
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  products   Product[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model Product {
  id                   String        @id @default(uuid(7)) @db.Uuid
  restaurantId         String        @db.Uuid
  menuCategoryId       String?       @db.Uuid
  categoryId           String?       @db.Uuid
  name                 String
  description          String?
  foodType             FoodType      @default(VEG)
  basePricePaise       Int // restaurant's price; NEVER mutated by markup
  packagingChargePaise Int? // per unit; null = inherit restaurant/global packaging config
  taxInclusive         Boolean? // null = inherit from TaxRule
  prepTimeMinutes      Int?
  isBestseller         Boolean       @default(false)
  isRecommended        Boolean       @default(false)
  isFeatured           Boolean       @default(false)
  status               ProductStatus @default(ACTIVE)
  isAvailable          Boolean       @default(true) // sold-out toggle
  stockQuantity        Int? // null = not stock-tracked
  sortOrder            Int           @default(0)
  searchText           String? // denormalised for Postgres full-text search
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id])
  menuCategory MenuCategory?         @relation(fields: [menuCategoryId], references: [id])
  category     Category?             @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  addonGroups  ProductAddonGroup[]
  images       ProductImage[]
  availability ProductAvailability[]
  schedules    ProductSchedule[]

  @@index([restaurantId, status, isAvailable])
  @@index([menuCategoryId, sortOrder])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id             String  @id @default(uuid(7)) @db.Uuid
  productId      String  @db.Uuid
  name           String // "Half", "Full", "Medium 10\""
  basePricePaise Int
  isDefault      Boolean @default(false)
  isAvailable    Boolean @default(true)
  sortOrder      Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductAddonGroup {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid
  name      String // "Choose your toppings"
  minSelect Int    @default(0)
  maxSelect Int    @default(1)
  sortOrder Int    @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  addons  ProductAddon[]

  @@index([productId])
  @@map("product_addon_groups")
}

model ProductAddon {
  id             String   @id @default(uuid(7)) @db.Uuid
  groupId        String   @db.Uuid
  name           String
  basePricePaise Int      @default(0)
  foodType       FoodType @default(VEG)
  isAvailable    Boolean  @default(true)
  sortOrder      Int      @default(0)

  group ProductAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_addons")
}

model ProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid
  mediaId   String @db.Uuid
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@index([productId])
  @@map("product_images")
}

/// Date-bounded availability overrides (e.g. sold out until tomorrow).
model ProductAvailability {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @db.Uuid
  isAvailable Boolean
  startsAt    DateTime
  endsAt      DateTime?
  reason      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startsAt])
  @@map("product_availability")
}

/// Recurring windows when a product can be ordered (e.g. breakfast 07:00–11:00).
model ProductSchedule {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @db.Uuid
  dayOfWeek Int
  startsAt  String // HH:mm
  endsAt    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, dayOfWeek])
  @@map("product_schedules")
}

// ───────────────────────────── Riders ─────────────────────────────

model Rider {
  id                         String                @id @default(uuid(7)) @db.Uuid
  userId                     String                @unique @db.Uuid
  cityId                     String?               @db.Uuid
  homeZoneId                 String?               @db.Uuid
  onboardingStatus           RiderOnboardingStatus @default(APPLIED)
  photoMediaId               String?               @db.Uuid
  addressLine                String?
  codEnabled                 Boolean               @default(true)
  codLimitPaise              Int? // null = inherit from config
  upiId                      String?
  bankAccountNumberEncrypted String?
  bankAccountLast4           String?
  bankIfsc                   String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  documents    RiderDocument[]
  vehicles     RiderVehicle[]
  availability RiderAvailability?
  locations    RiderLocation[]
  shifts       RiderShift[]
  earnings     RiderEarning[]
  payouts      RiderPayout[]
  assignments  OrderAssignment[]
  ledger       RiderLedger?
  settlements  RiderSettlement[]
  codDeposits  RiderCodDeposit[]

  @@index([cityId, onboardingStatus])
  @@map("riders")
}

model RiderDocument {
  id           String         @id @default(uuid(7)) @db.Uuid
  riderId      String         @db.Uuid
  kind         String // AADHAAR, DRIVING_LICENCE, RC, PAN, INSURANCE
  number       String? // stored masked/encrypted at app layer
  mediaId      String?        @db.Uuid
  status       DocumentStatus @default(PENDING)
  expiresOn    DateTime?      @db.Date
  reviewedById String?        @db.Uuid
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@map("rider_documents")
}

model RiderVehicle {
  id                 String      @id @default(uuid(7)) @db.Uuid
  riderId            String      @db.Uuid
  type               VehicleType
  registrationNumber String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@map("rider_vehicles")
}

/// Live dispatch state (one row per rider; hot, frequently updated).
model RiderAvailability {
  riderId          String    @id @db.Uuid
  isOnline         Boolean   @default(false)
  activeOrderCount Int       @default(0)
  lastLat          Decimal?  @db.Decimal(9, 6)
  lastLng          Decimal?  @db.Decimal(9, 6)
  lastLocationAt   DateTime?
  zoneId           String?   @db.Uuid
  updatedAt        DateTime  @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([isOnline, zoneId])
  @@map("rider_availability")
}

/// Location breadcrumb trail (append-only; partition/TTL in production — see DATABASE.md).
model RiderLocation {
  id         String   @id @default(uuid(7)) @db.Uuid
  riderId    String   @db.Uuid
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  accuracyM  Int?
  speedMps   Decimal? @db.Decimal(6, 2)
  headingDeg Int?
  orderId    String?  @db.Uuid
  recordedAt DateTime // device timestamp
  receivedAt DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, recordedAt])
  @@map("rider_locations")
}

model RiderShift {
  id        String    @id @default(uuid(7)) @db.Uuid
  riderId   String    @db.Uuid
  startedAt DateTime
  endedAt   DateTime?
  zoneId    String?   @db.Uuid

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, startedAt])
  @@map("rider_shifts")
}

/// Per-order rider earning with the full calculation breakdown (immutable).
model RiderEarning {
  id         String   @id @default(uuid(7)) @db.Uuid
  riderId    String   @db.Uuid
  orderId    String   @unique @db.Uuid
  ruleId     String?  @db.Uuid
  totalPaise Int
  breakdown  Json // { base, pickupDistance, deliveryDistance, waiting, night, peak, manual, … }
  createdAt  DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([riderId, createdAt])
  @@map("rider_earnings")
}

model RiderPayout {
  id           String           @id @default(uuid(7)) @db.Uuid
  riderId      String           @db.Uuid
  settlementId String?          @db.Uuid
  amountPaise  Int
  status       SettlementStatus @default(PENDING)
  reference    String?
  paidAt       DateTime?
  createdAt    DateTime         @default(now())

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, createdAt])
  @@map("rider_payouts")
}

// ───────────────────────────── Commercial rules (versioned) ─────────────────────────────
// Every rule table shares the same shape: scope + scopeRefId + typed `params` JSON
// (validated by @bitemitra/pricing-engine schemas) + validity window + version chain.
// Resolution: most specific scope wins; ties broken by `priority` then newest.

model MarkupRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid // null only for GLOBAL
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { type: PERCENTAGE|FIXED, valueBps?, valuePaise?, rounding }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("markup_rules")
}

model CommissionRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { type: PERCENTAGE|FIXED|HYBRID, rateBps?, fixedPaise?, taxRateBps? }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("commission_rules")
}

model TaxRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { mode: INCLUSIVE|EXCLUSIVE|EXEMPT, components: [{ code: CGST, rateBps }], appliesTo: [...] }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("tax_rules")
}

model PlatformFeeRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { enabled, fixedPaise, rateBps, minPaise, maxPaise, schedule? }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("platform_fee_rules")
}

model DeliveryPricingRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { strategy: SLABS|BASE_PLUS_PER_KM, slabs?, basePaise?, includedM?, perKmPaise?, minPaise?, maxPaise?, freeAbovePaise?, smallOrder? }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("delivery_pricing_rules")
}

model RiderEarningRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json // { basePaise, perKmPaise, slabs?, minPaise, waitingPerMinPaise, nightIncentive?, peakIncentive? }
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("rider_earning_rules")
}

/// Night (scheduled) and manual/demand surge rules.
model SurgeRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  kind          String // NIGHT | DEMAND | WEATHER | MANUAL
  params        Json // { startTime?, endTime?, type: FIXED|PERCENTAGE|MULTIPLIER, value }
  isEnabled     Boolean     @default(true) // instant kill-switch (spec §15)
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, kind, effectiveFrom])
  @@map("surge_rules")
}

/// Cancellation / refund policy per order stage (spec §35). params:
/// { stage: BEFORE_ACCEPT|AFTER_ACCEPT|AFTER_PREPARING|AFTER_PICKUP, actor: CUSTOMER|RESTAURANT|RIDER|ADMIN,
///   customerFee: { type, value }, refundPolicy: FULL|PARTIAL|NONE, restaurantCompensation: {...},
///   riderCompensation: {...} }
model CancellationRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  scope         ConfigScope
  scopeRefId    String?     @db.Uuid
  restaurantId  String?     @db.Uuid // qualifier: CATEGORY rule limited to one restaurant (ranks above an unqualified CATEGORY rule)
  params        Json
  priority      Int         @default(0)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  supersedesId  String?     @unique @db.Uuid
  createdById   String?     @db.Uuid
  changeNote    String?
  createdAt     DateTime    @default(now())

  @@index([scope, scopeRefId, effectiveFrom])
  @@map("cancellation_rules")
}

/// Generic hierarchical key/value settings (operational config, not money rules).
/// e.g. orders.restaurantAcceptanceTimeoutSec, cod.maxOrderValuePaise, app.minVersion.
model Setting {
  id          String      @id @default(uuid(7)) @db.Uuid
  key         String
  scope       ConfigScope
  scopeRefId  String?     @db.Uuid
  value       Json
  updatedById String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  history SettingHistory[]

  @@unique([key, scope, scopeRefId])
  @@index([key])
  @@map("settings")
}

model SettingHistory {
  id          String   @id @default(uuid(7)) @db.Uuid
  settingId   String   @db.Uuid
  key         String
  oldValue    Json?
  newValue    Json?
  changedById String?  @db.Uuid
  changedAt   DateTime @default(now())

  setting Setting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@index([settingId, changedAt])
  @@map("setting_history")
}

model FeatureFlag {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique // e.g. cod, tips, surge, rider_batching
  description String?
  enabled     Boolean  @default(false)
  /// Targeting: { cityIds?: [], zoneIds?: [], apps?: [], minAppVersion?: "1.2.0", rolloutPercent?: 0-100 }
  rules       Json     @default("{}")
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

/// Per-app, per-platform version policy (spec §72).
model AppVersionPolicy {
  id                  String         @id @default(uuid(7)) @db.Uuid
  appId               AppId
  platform            DevicePlatform
  minSupportedVersion String
  recommendedVersion  String
  forceUpdate         Boolean        @default(false)
  storeUrl            String?
  updatedById         String?        @db.Uuid
  updatedAt           DateTime       @updatedAt

  @@unique([appId, platform])
  @@map("app_version_policies")
}

// ───────────────────────────── Promotions ─────────────────────────────

model Coupon {
  id                 String        @id @default(uuid(7)) @db.Uuid
  code               String        @unique // upper-case
  description        String?
  discountType       DiscountType
  valueBps           Int? // PERCENTAGE
  valuePaise         Int? // FIXED
  maxDiscountPaise   Int?
  minOrderPaise      Int?
  fundingSource      FundingSource @default(PLATFORM)
  restaurantShareBps Int? // SHARED: restaurant's share of the discount
  firstOrderOnly     Boolean       @default(false)
  usageLimit         Int?
  perUserLimit       Int?
  usedCount          Int           @default(0)
  targeting          Json          @default("{}") // { cityIds, zoneIds, restaurantIds, categoryIds, productIds, paymentMethods }
  startsAt           DateTime
  endsAt             DateTime?
  isActive           Boolean       @default(true)
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  usages CouponUsage[]

  @@index([isActive, startsAt])
  @@map("coupons")
}

model CouponUsage {
  id            String    @id @default(uuid(7)) @db.Uuid
  couponId      String    @db.Uuid
  customerId    String    @db.Uuid
  orderId       String    @unique @db.Uuid
  discountPaise Int
  reversedAt    DateTime? // order cancelled → usage released
  createdAt     DateTime  @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, customerId])
  @@map("coupon_usages")
}

/// Automatic (code-less) promotions, e.g. restaurant "20% off above ₹299".
model Promotion {
  id                 String        @id @default(uuid(7)) @db.Uuid
  name               String
  discountType       DiscountType
  valueBps           Int?
  valuePaise         Int?
  maxDiscountPaise   Int?
  minOrderPaise      Int?
  fundingSource      FundingSource @default(RESTAURANT)
  restaurantShareBps Int?
  targeting          Json          @default("{}")
  startsAt           DateTime
  endsAt             DateTime?
  isActive           Boolean       @default(true)
  priority           Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([isActive, startsAt])
  @@map("promotions")
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id                     String                @id @default(uuid(7)) @db.Uuid
  orderNumber            String                @unique // human friendly, e.g. BM-UNJ-240924-00042
  customerId             String                @db.Uuid
  restaurantId           String                @db.Uuid
  branchId               String                @db.Uuid
  cityId                 String                @db.Uuid
  zoneId                 String?               @db.Uuid // DELIVERY zone (customer's); restaurant zone is in the snapshot
  type                   OrderType             @default(DELIVERY)
  /// Overall lifecycle status (spec §18), DERIVED from the two tracks below by
  /// @bitemitra/order-engine and written in the same transaction.
  status                 OrderStatus           @default(CREATED)
  restaurantStatus       RestaurantOrderStatus @default(PENDING)
  deliveryStatus         DeliveryStatus        @default(NOT_STARTED)
  financialStatus        OrderFinancialStatus  @default(NONE)
  paymentMethod          PaymentMethod
  /// Client-supplied idempotency key: a retried "place order" returns the same order.
  idempotencyKey         String
  totalPayablePaise      Int // what the customer pays (copy of snapshot for fast listing)
  codAmountPaise         Int                   @default(0)
  itemCount              Int
  deliveryInstructions   String?
  restaurantInstructions String?
  contactless            Boolean               @default(false)
  deliveryOtpHash        String?
  prepTimeMinutes        Int?
  scheduledFor           DateTime? // future: scheduled delivery
  placedAt               DateTime?
  acceptedAt             DateTime?
  readyAt                DateTime?
  pickedUpAt             DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  settlementStatus       SettlementStatus?
  appVersion             String?
  platform               DevicePlatform?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  /// Optimistic-concurrency counter for state transitions.
  version                Int                   @default(0)

  customer        Customer              @relation(fields: [customerId], references: [id])
  restaurant      Restaurant            @relation(fields: [restaurantId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  pricingSnapshot OrderPricingSnapshot?
  address         OrderAddress?
  notes           OrderNote[]
  assignments     OrderAssignment[]
  payments        Payment[]
  refunds         Refund[]
  couponUsage     CouponUsage?
  riderEarning    RiderEarning?
  review          Review?
  supportTickets  SupportTicket[]
  cancellation    OrderCancellation?
  invoices        Invoice[]

  @@unique([customerId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([cityId, zoneId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([deliveryStatus, createdAt])
  @@map("orders")
}

/// Immutable per-line snapshot: product/variant names and every price component.
model OrderItem {
  id                        String   @id @default(uuid(7)) @db.Uuid
  orderId                   String   @db.Uuid
  productId                 String   @db.Uuid
  variantId                 String?  @db.Uuid
  productName               String
  variantName               String?
  foodType                  FoodType
  quantity                  Int
  restaurantBasePricePaise  Int // unit, incl. variant, excl. add-ons
  customerDisplayPricePaise Int // unit after markup (+rounding)
  markupType                String?
  markupValue               Int? // bps or paise depending on type
  markupAmountPaise         Int // per unit
  markupRuleId              String?  @db.Uuid
  taxMode                   String // INCLUSIVE | EXCLUSIVE | EXEMPT
  taxRateBps                Int
  taxAmountPaise            Int // line total
  commissionRateBps         Int?
  commissionAmountPaise     Int // line total
  packagingPaise            Int      @default(0) // line total
  lineTotalPaise            Int // customer-facing line total incl. add-ons
  createdAt                 DateTime @default(now())

  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addons OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemAddon {
  id                        String @id @default(uuid(7)) @db.Uuid
  orderItemId               String @db.Uuid
  addonId                   String @db.Uuid
  groupName                 String
  name                      String
  restaurantBasePricePaise  Int
  customerDisplayPricePaise Int
  markupAmountPaise         Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_addons")
}

/// Append-only log of every state transition (spec §18).
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  actorId    String?      @db.Uuid
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Immutable financial snapshot (spec §27, §30, §82). Written once in the order-creation
/// transaction; never updated. Refunds/adjustments are separate rows elsewhere.
model OrderPricingSnapshot {
  orderId                       String   @id @db.Uuid
  engineVersion                 String // pricing-engine version that produced it
  currency                      String   @default("INR")
  restaurantBaseSubtotalPaise   Int
  customerFoodSubtotalPaise     Int
  markupTotalPaise              Int
  packagingPaise                Int
  taxTotalPaise                 Int
  taxBreakdown                  Json // [{ code, rateBps, amountPaise, on }]
  deliveryFeePaise              Int
  deliveryRule                  Json // exact rule params + id + computed distance
  distanceM                     Int
  platformFeePaise              Int
  platformFeeRule               Json?
  smallOrderFeePaise            Int
  nightSurchargePaise           Int
  surgePaise                    Int
  surgeRules                    Json?
  otherFees                     Json? // [{ code, label, amountPaise }]
  discountTotalPaise            Int
  restaurantFundedDiscountPaise Int
  platformFundedDiscountPaise   Int
  couponCode                    String?
  couponSnapshot                Json? // funding source, share, caps at time of order
  tipPaise                      Int
  roundingAdjustmentPaise       Int
  totalPayablePaise             Int
  commissionRateBps             Int?
  commissionAmountPaise         Int
  commissionTaxPaise            Int
  commissionRule                Json
  restaurantPayablePaise        Int
  riderEarningEstimatePaise     Int
  riderEarningRule              Json?
  gatewayFeeEstimatePaise       Int      @default(0)
  platformRevenue               Json // { markup, commission, platformFee, deliveryMargin, smallOrderFee, surcharges, … }
  appliedRuleIds                Json // all rule ids consulted (audit)
  createdAt                     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_pricing_snapshots")
}

model OrderAddress {
  orderId      String  @id @db.Uuid
  label        String?
  line1        String
  line2        String?
  landmark     String?
  area         String?
  cityName     String
  pincode      String?
  lat          Decimal @db.Decimal(9, 6)
  lng          Decimal @db.Decimal(9, 6)
  contactName  String?
  contactPhone String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  orderId    String    @db.Uuid
  authorType ActorType
  authorId   String?   @db.Uuid
  isInternal Boolean   @default(true)
  body       String
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_notes")
}

/// Rider offers/assignments. The partial unique index "one ACCEPTED assignment per order"
/// is created in a SQL migration (Prisma cannot express partial indexes) — spec §69.
model OrderAssignment {
  id              String           @id @default(uuid(7)) @db.Uuid
  orderId         String           @db.Uuid
  riderId         String           @db.Uuid
  status          AssignmentStatus @default(OFFERED)
  isManual        Boolean          @default(false)
  assignedById    String?          @db.Uuid
  strategy        String? // dispatch algorithm id + version
  score           Decimal?         @db.Decimal(10, 4)
  pickupDistanceM Int?
  offeredAt       DateTime         @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?
  rejectReason    String?

  order Order @relation(fields: [orderId], references: [id])
  rider Rider @relation(fields: [riderId], references: [id])

  @@index([orderId, status])
  @@index([riderId, status])
  @@map("order_assignments")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @db.Uuid
  method            PaymentMethod
  provider          String // razorpay | cashfree | cod | …
  status            PaymentStatus @default(INITIATED)
  amountPaise       Int
  capturedPaise     Int           @default(0)
  refundedPaise     Int           @default(0)
  gatewayFeePaise   Int?
  gatewayTaxPaise   Int?
  providerOrderId   String?
  providerPaymentId String?
  /// COD reconciliation (spec §23)
  codCollectedById  String?       @db.Uuid
  codCollectedAt    DateTime?
  codReconciledAt   DateTime?
  codSettlementRef  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  attempts PaymentAttempt[]
  events   PaymentEvent[]
  refunds  Refund[]

  @@unique([provider, providerOrderId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String        @id @default(uuid(7)) @db.Uuid
  paymentId         String        @db.Uuid
  status            PaymentStatus
  providerPaymentId String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_attempts")
}

/// Raw provider webhook/callback events. `(provider, providerEventId)` unique →
/// duplicate deliveries are no-ops (spec §24, §69).
model PaymentEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String
  paymentId       String?   @db.Uuid
  eventType       String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @db.Uuid
  paymentId        String?      @db.Uuid // null for COD refunds paid by other means
  type             RefundType
  status           RefundStatus @default(REQUESTED)
  amountPaise      Int
  reason           String
  breakdown        Json? // which components (items/delivery/platform fee) are refunded
  /// Prevents accidental duplicate refunds: the same request can't be created twice.
  idempotencyKey   String       @unique
  actorType        ActorType
  actorId          String?      @db.Uuid
  providerRefundId String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// ───────────────────────────── Ledgers & settlements ─────────────────────────────

model RestaurantLedger {
  id           String   @id @default(uuid(7)) @db.Uuid
  restaurantId String   @unique @db.Uuid
  balancePaise BigInt   @default(0) // positive = platform owes restaurant
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id])
  entries    RestaurantLedgerEntry[]

  @@map("restaurant_ledgers")
}

/// Append-only. Corrections are new entries, never edits.
model RestaurantLedgerEntry {
  id                String                    @id @default(uuid(7)) @db.Uuid
  ledgerId          String                    @db.Uuid
  type              RestaurantLedgerEntryType
  direction         LedgerDirection
  amountPaise       BigInt // always positive; sign given by direction
  balanceAfterPaise BigInt
  orderId           String?                   @db.Uuid
  refundId          String?                   @db.Uuid
  settlementId      String?                   @db.Uuid
  description       String?
  /// Unique business key, e.g. "order:<id>:FOOD_SALE" → the same posting can't happen twice.
  idempotencyKey    String                    @unique
  createdById       String?                   @db.Uuid
  createdAt         DateTime                  @default(now())

  ledger     RestaurantLedger      @relation(fields: [ledgerId], references: [id])
  settlement RestaurantSettlement? @relation(fields: [settlementId], references: [id])

  @@index([ledgerId, createdAt])
  @@index([orderId])
  @@map("restaurant_ledger_entries")
}

model RestaurantSettlement {
  id               String             @id @default(uuid(7)) @db.Uuid
  restaurantId     String             @db.Uuid
  periodStart      DateTime
  periodEnd        DateTime
  schedule         SettlementSchedule
  openingPaise     BigInt
  creditsPaise     BigInt
  debitsPaise      BigInt
  netPayablePaise  BigInt
  status           SettlementStatus   @default(DRAFT)
  payoutReference  String?
  paidAt           DateTime?
  statementMediaId String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id])
  entries    RestaurantLedgerEntry[]

  @@unique([restaurantId, periodStart, periodEnd]) // no duplicate settlement (spec §69)
  @@map("restaurant_settlements")
}

model RiderLedger {
  id                   String   @id @default(uuid(7)) @db.Uuid
  riderId              String   @unique @db.Uuid
  earningsBalancePaise BigInt   @default(0) // platform owes rider
  codHeldPaise         BigInt   @default(0) // rider owes platform (cash in hand)
  version              Int      @default(0)
  updatedAt            DateTime @updatedAt

  rider   Rider              @relation(fields: [riderId], references: [id])
  entries RiderLedgerEntry[]

  @@map("rider_ledgers")
}

model RiderLedgerEntry {
  id             String               @id @default(uuid(7)) @db.Uuid
  ledgerId       String               @db.Uuid
  type           RiderLedgerEntryType
  direction      LedgerDirection
  amountPaise    BigInt
  orderId        String?              @db.Uuid
  settlementId   String?              @db.Uuid
  description    String?
  idempotencyKey String               @unique
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now())

  ledger     RiderLedger      @relation(fields: [ledgerId], references: [id])
  settlement RiderSettlement? @relation(fields: [settlementId], references: [id])

  @@index([ledgerId, createdAt])
  @@index([orderId])
  @@map("rider_ledger_entries")
}

model RiderSettlement {
  id              String           @id @default(uuid(7)) @db.Uuid
  riderId         String           @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  earningsPaise   BigInt
  codOwedPaise    BigInt
  netPayablePaise BigInt // may be negative: rider owes platform
  status          SettlementStatus @default(DRAFT)
  payoutReference String?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rider   Rider              @relation(fields: [riderId], references: [id])
  entries RiderLedgerEntry[]

  @@unique([riderId, periodStart, periodEnd])
  @@map("rider_settlements")
}

model PlatformLedgerEntry {
  id             String                  @id @default(uuid(7)) @db.Uuid
  type           PlatformLedgerEntryType
  direction      LedgerDirection
  amountPaise    BigInt
  orderId        String?                 @db.Uuid
  cityId         String?                 @db.Uuid
  description    String?
  idempotencyKey String                  @unique
  createdAt      DateTime                @default(now())

  @@index([orderId])
  @@index([type, createdAt])
  @@map("platform_ledger_entries")
}

// ───────────────────────────── Reviews & support ─────────────────────────────

model Review {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @unique @db.Uuid
  customerId     String   @db.Uuid
  restaurantId   String   @db.Uuid
  foodRating     Int // 1–5
  deliveryRating Int?
  comment        String?
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt])
  @@map("reviews")
}

model SupportTicket {
  id           String              @id @default(uuid(7)) @db.Uuid
  ticketNumber String              @unique
  customerId   String?             @db.Uuid
  orderId      String?             @db.Uuid
  raisedByType ActorType
  raisedById   String?             @db.Uuid
  issueType    SupportIssueType
  status       SupportTicketStatus @default(OPEN)
  subject      String
  description  String?
  assignedToId String?             @db.Uuid
  resolution   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer Customer?              @relation(fields: [customerId], references: [id])
  order    Order?                 @relation(fields: [orderId], references: [id])
  messages SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([orderId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String    @id @default(uuid(7)) @db.Uuid
  ticketId   String    @db.Uuid
  authorType ActorType
  authorId   String?   @db.Uuid
  body       String
  isInternal Boolean   @default(false) // agent-only note
  mediaIds   String[]  @db.Uuid
  createdAt  DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// ───────────────────────────── Notifications ─────────────────────────────

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  event     String // ORDER_PLACED, RESTAURANT_ACCEPTED …
  channel   NotificationChannel
  appId     AppId
  locale    String              @default("en")
  title     String?
  body      String // mustache-style {{orderNumber}} placeholders
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([event, channel, appId, locale])
  @@map("notification_templates")
}

model Notification {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String?             @db.Uuid
  appId       AppId
  channel     NotificationChannel
  event       String
  title       String?
  body        String
  data        Json?
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  error       String?
  dedupeKey   String?             @unique
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ───────────────────────────── CMS & media ─────────────────────────────

model Media {
  id           String    @id @default(uuid(7)) @db.Uuid
  kind         MediaKind @default(IMAGE)
  storageKey   String    @unique // object key in S3-compatible storage
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  title        String?
  tags         String[]
  /// Generated renditions: { thumb: key, small: key, medium: key, large: key }
  variants     Json      @default("{}")
  status       String    @default("PENDING") // PENDING upload → READY → (DELETED)
  uploadedById String?   @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  productImages ProductImage[]

  @@index([kind, createdAt])
  @@map("media")
}

model CmsPage {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique // terms, privacy, faq …
  title       String
  body        String // Markdown
  isPublished Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}

model HomeSection {
  id         String          @id @default(uuid(7)) @db.Uuid
  type       HomeSectionType
  title      String?
  subtitle   String?
  mediaId    String?         @db.Uuid
  background String?
  ctaLabel   String?
  deepLink   String?
  /// Type-specific configuration (restaurant ids, cuisine, price cap, …)
  config     Json            @default("{}")
  position   Int             @default(0)
  cityIds    String[]        @db.Uuid // empty = all cities
  zoneIds    String[]        @db.Uuid
  audience   Json            @default("{}") // e.g. { newCustomers: true }
  startsAt   DateTime?
  endsAt     DateTime?
  isEnabled  Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  banners Banner[]

  @@index([isEnabled, position])
  @@map("home_sections")
}

model Banner {
  id            String    @id @default(uuid(7)) @db.Uuid
  homeSectionId String?   @db.Uuid
  mediaId       String    @db.Uuid
  title         String?
  deepLink      String?
  position      Int       @default(0)
  cityIds       String[]  @db.Uuid
  zoneIds       String[]  @db.Uuid
  startsAt      DateTime?
  endsAt        DateTime?
  isEnabled     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  homeSection HomeSection? @relation(fields: [homeSectionId], references: [id])

  @@index([homeSectionId, position])
  @@map("banners")
}

// ───────────────────────────── Audit & idempotency ─────────────────────────────

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String // e.g. commission_rule.update, order.cancel, refund.create
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox: domain events are inserted in the SAME transaction as the
/// state change, then relayed to the queue by a worker. Guarantees no lost
/// notifications/dispatch triggers if the process crashes after commit.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String // ORDER | PAYMENT | SETTLEMENT …
  aggregateId   String    @db.Uuid
  eventType     String // order.placed, order.restaurant_accepted, payment.succeeded …
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Generic API idempotency store for mutating endpoints (Idempotency-Key header).
model IdempotencyRecord {
  id           String    @id @default(uuid(7)) @db.Uuid
  scope        String // userId or client id
  key          String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  lockedAt     DateTime  @default(now())
  completedAt  DateTime?
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ───────────────────────────── Cancellations, COD cash, invoices ─────────────────────────────

/// Outcome of a cancellation (spec §35): who, why, and who absorbs what. Written in the
/// same transaction as the cancellation transition; admin overrides are audit-logged.
model OrderCancellation {
  orderId                     String    @id @db.Uuid
  stage                       String // BEFORE_ACCEPT | AFTER_ACCEPT | AFTER_PREPARING | AFTER_PICKUP
  cancelledByType             ActorType
  cancelledById               String?   @db.Uuid
  reasonCode                  String
  reasonText                  String?
  ruleId                      String?   @db.Uuid // CancellationRule applied
  ruleSnapshot                Json
  customerFeePaise            Int       @default(0)
  refundDuePaise              Int       @default(0)
  restaurantCompensationPaise Int       @default(0)
  riderCompensationPaise      Int       @default(0)
  platformLossPaise           Int       @default(0)
  isAdminOverride             Boolean   @default(false)
  createdAt                   DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_cancellations")
}

/// Cash a rider hands over (spec §23). COD is only platform cash once a deposit is
/// verified; the rider ledger records COD_SUBMITTED against it.
model RiderCodDeposit {
  id             String    @id @default(uuid(7)) @db.Uuid
  riderId        String    @db.Uuid
  amountPaise    Int
  method         String // CASH_AT_HUB | BANK_DEPOSIT | UPI
  reference      String? // bank/UPI reference or hub receipt number
  status         String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  receivedById   String?   @db.Uuid
  verifiedById   String?   @db.Uuid
  verifiedAt     DateTime?
  note           String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, createdAt])
  @@index([status])
  @@map("rider_cod_deposits")
}

/// Tax invoices / credit notes. Numbering is gap-free per (series, financialYear) via
/// InvoiceSequence row locks. Which documents are issued, and by which legal entity,
/// is a tax decision — see docs/PRICING.md "Open tax questions".
model Invoice {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String?  @db.Uuid
  restaurantId   String?  @db.Uuid // for commission invoices raised on restaurants
  type           String // CUSTOMER_FOOD | CUSTOMER_PLATFORM_SERVICES | RESTAURANT_COMMISSION | CREDIT_NOTE
  series         String
  financialYear  String // e.g. 2026-27
  number         String   @unique
  issuerGstin    String?
  recipientGstin String?
  amounts        Json // taxable value, tax components, totals — all paise
  pdfMediaId     String?  @db.Uuid
  issuedAt       DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([restaurantId, issuedAt])
  @@map("invoices")
}

model InvoiceSequence {
  series        String
  financialYear String
  nextNumber    Int    @default(1)

  @@id([series, financialYear])
  @@map("invoice_sequences")
}

// ───────────────────────────── Admin UX & search ─────────────────────────────

/// Saved table views (spec §29): filters + columns + sort, private or shared.
model AdminSavedView {
  id          String   @id @default(uuid(7)) @db.Uuid
  adminUserId String   @db.Uuid
  resource    String // orders | restaurants | riders | …
  name        String
  query       Json
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([adminUserId, resource])
  @@map("admin_saved_views")
}

/// Search log feeding "popular searches" and relevance tuning (spec §38).
model SearchQuery {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String?  @db.Uuid
  cityId      String?  @db.Uuid
  query       String
  resultCount Int
  clickedType String? // RESTAURANT | PRODUCT | CUISINE
  clickedId   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([cityId, createdAt])
  @@index([customerId, createdAt])
  @@map("search_queries")
}
