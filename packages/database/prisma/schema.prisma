/// Transactional outbox: domain events are inserted in the SAME transaction as the
/// state change, then relayed to the queue by a worker. Guarantees no lost
/// notifications/dispatch triggers if the process crashes after commit.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String // ORDER | PAYMENT | SETTLEMENT …
  aggregateId   String    @db.Uuid
  eventType     String // order.placed, order.restaurant_accepted, payment.succeeded …
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Not processed before this time (delayed jobs such as acceptance timeouts).
  availableAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Claimed by a worker (FOR UPDATE SKIP LOCKED); a stale lock is reclaimable after the lease.
  lockedAt      DateTime? @db.Timestamptz(3)
  lockedBy      String?
  publishedAt   DateTime? @db.Timestamptz(3) // handled successfully
  attempts      Int       @default(0)
  lastError     String?
  /// Parked after max attempts — needs operator attention; never retried automatically.
  failedAt      DateTime? @db.Timestamptz(3)

  @@index([publishedAt, failedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

