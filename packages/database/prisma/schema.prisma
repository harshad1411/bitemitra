/// A restaurant brand/business. Physical outlets are RestaurantBranch; today every
/// restaurant has exactly one branch, but chains / multi-branch are supported (spec §76).
model Restaurant {
  id               String                     @id @default(uuid(7)) @db.Uuid
  cityId           String                     @db.Uuid
  slug             String                     @unique
  name             String
  legalName        String?
  description      String?
  cuisines         String[]
  isPureVeg        Boolean                    @default(false)
  logoMediaId      String?                    @db.Uuid
  coverMediaId     String?                    @db.Uuid
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  fssaiNumber      String?
  fssaiExpiresOn   DateTime?                  @db.Date
  onboardingStatus RestaurantOnboardingStatus @default(DRAFT)
  isPromoted       Boolean                    @default(false)
  ratingAvg        Decimal                    @default(0) @db.Decimal(3, 2)
  ratingCount      Int                        @default(0)
  sortWeight       Int                        @default(0) // admin-controlled ordering
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)

  city           City                    @relation(fields: [cityId], references: [id])
  branches       RestaurantBranch[]
  users          RestaurantUser[]
  documents      RestaurantDocument[]
  bankAccounts   RestaurantBankAccount[]
  settings       RestaurantSettings?
  zones          RestaurantZone[]
  menuCategories MenuCategory[]
  products       Product[]
  favorites      FavoriteRestaurant[]

  @@index([cityId, onboardingStatus])
  @@map("restaurants")
}

model RestaurantBranch {
  id              String    @id @default(uuid(7)) @db.Uuid
  restaurantId    String    @db.Uuid
  name            String
  addressLine     String
  area            String?
  pincode         String?
  lat             Decimal   @db.Decimal(9, 6)
  lng             Decimal   @db.Decimal(9, 6)
  zoneId          String?   @db.Uuid
  isPrimary       Boolean   @default(true)
  isOpen          Boolean   @default(true) // false = manually closed until reopened (D-38)
  pausedUntil     DateTime? @db.Timestamptz(3) // temporary pause
  busyMode        Boolean   @default(false)
  prepTimeMinutes Int       @default(20)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  restaurant    Restaurant                @relation(fields: [restaurantId], references: [id])
  businessHours RestaurantBusinessHours[]
  deliveryAreas BranchDeliveryArea[]

  @@index([restaurantId])
  @@index([lat, lng])
  @@map("restaurant_branches")
}

/// A branch's own delivery reach ("Delivery Area" in the owner's hierarchy, DECISIONS D-19):
/// radius or polygon. The customer must be inside BOTH a zone service area and a branch area.
model BranchDeliveryArea {
  id        String   @id @default(uuid(7)) @db.Uuid
  branchId  String   @db.Uuid
  kind      String // RADIUS | POLYGON
