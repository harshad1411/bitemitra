{
  "//": "Static checking of JavaScript only (DECISIONS D-1). No TypeScript source exists; nothing is emitted.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/shared-types/src",
    "packages/config/src",
    "packages/validation/src",
    "packages/logger/src",
    "packages/auth/src",
    "packages/notifications/src",
    "packages/pricing-engine/src",
    "packages/delivery-engine/src",
    "packages/catalog-engine/src",
    "packages/order-engine/src",
    "packages/settlement-engine/src",
    "packages/api-client/src",
    "packages/ui/src",
    "packages/database/src",
    "services/api/src",
    "services/workers/src",
    "scripts"
  ],
  "exclude": ["**/*.test.js", "**/node_modules"]
}
